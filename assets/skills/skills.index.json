  "contracts": {
    "vocabulary": "scripts/lib/dimensions.mjs (A 族唯一来源；禁 B 族旧称)",
    "ledger": ".cycles/gates/ledger.json (append-only 哈希链)",
    "scripts": "SKILL_SCRIPTS 白名单 (skillInvoker.ts)",
    "paths": ".cycles/ (唯一产物根)"
  },
  "selfEvolution": {
    "metaSkill": "skill-library-evolution",
    "threeAnchors": ["SKILL.md", "scripts/<primary>.mjs", "CHANGELOG.md"],
    "gate": "skill-lib --check (错误级 exit 1)",
    "patchLifecycle": "proposed → human-approved → applied → benchmarked → kept|reverted",
    "trustThresholds": { "L2-L3": 70, "L3-L4": 85 },
    "breakerRule": "先修复后降级；升级需人类、降级可自动（12 号宪章）"
  }
